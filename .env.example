# Plesk Server Configuration
PLESK_HOST=your-plesk-server.com
PLESK_PORT=8443
PLESK_SECURE=true

# Authentication (use API key OR username/password)
PLESK_API_KEY=your-api-key-here
# OR
# PLESK_USERNAME=admin
# PLESK_PASSWORD=your-password

# Security: Only set to false for development with self-signed certificates
# PLESK_REJECT_UNAUTHORIZED=false
